# このファイルを .streamlit/secrets.toml にコピーして値を埋めてください。
# Streamlit Community Cloud では、アプリの Settings → Secrets に同じ内容を貼り付けます。
# ※ secrets.toml は秘密情報です。Git にコミットしないでください。
# ※ 並び順が大事です。[gsheets] の行より「上」に admin_password などを書いてください。

admin_password = "1234"
# （任意）管理者メニューを必ず表示する人の名前。ふだんは管理者メニューの「👥 メンバー」で
# 「👑 管理者にする」を押して指定します。誰も入れなくなったときの予備に使ってください。
# admin_members = ["のり"]
# ログイン状態をURLに保存するときの暗号キー（任意・長いランダムな文字列）
token_secret = "ランダムな長い文字列"

# Google Cloud でダウンロードしたサービスアカウントの鍵（JSONファイル）を
# メモ帳などで開き、中身を { から } まで丸ごと ''' と ''' の間に貼り付けます。
gcp_service_account_json = '''
{
  "type": "service_account",
  "project_id": "your-project-id",
  "private_key_id": "xxxxxxxx",
  "private_key": "-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n",
  "client_email": "pickleball-app@your-project-id.iam.gserviceaccount.com",
  "client_id": "000000000000000000000",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token"
}
'''

[gsheets]
# スプレッドシートのURL（ブラウザのアドレス欄をそのままコピー）
spreadsheet = "https://docs.google.com/spreadsheets/d/XXXXXXXXXXXXXXXXXXXXXXXX/edit"

# ---- 別の書き方（上級者向け）----
# JSON の代わりに、次のように1項目ずつ書くこともできます（上の gcp_service_account_json は削除）。
# [gcp_service_account]
# type = "service_account"
# project_id = "your-project-id"
# private_key = "-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"
# client_email = "pickleball-app@your-project-id.iam.gserviceaccount.com"
# token_uri = "https://oauth2.googleapis.com/token"
